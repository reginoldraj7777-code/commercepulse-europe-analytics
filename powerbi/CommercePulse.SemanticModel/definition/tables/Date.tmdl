		sourceColumn: is_weekend

	column 'Is Month End'
		dataType: boolean
		lineageTag: 777140df-a18c-4d12-a1f1-734ccc106a8f
		summarizeBy: none
		sourceColumn: is_month_end

	partition Date = m
		mode: import
		source =
				let
				    Source = PostgreSQL.Database(Server, Database, [CreateNavigationProperties = false]),
				    Data = Source{[Schema = "portfolio", Item = "dim_date"]}[Data]
				in
				    Data

